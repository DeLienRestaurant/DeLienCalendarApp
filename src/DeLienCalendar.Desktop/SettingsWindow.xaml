<Window x:Class="DeLienCalendar.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - DeLien Calendar"
        Height="660" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7FB">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="通知" FontSize="16" FontWeight="Bold" Foreground="#1F2333" Margin="0,0,0,10" />

      <CheckBox x:Name="NotificationsEnabled" Content="通知を有効にする" Margin="0,0,0,8" />

      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="リマインド時刻:" VerticalAlignment="Center" Width="120" />
        <ComboBox x:Name="ReminderMinutes" Width="160" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="通知スタイル:" VerticalAlignment="Center" Width="120" />
        <ComboBox x:Name="StyleCombo" Width="300" SelectionChanged="StyleCombo_SelectionChanged" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="通知音:" VerticalAlignment="Center" Width="120" />
        <ComboBox x:Name="SoundCombo" Width="300" />
      </StackPanel>

      <CheckBox x:Name="ShowCalendarName" Content="通知にカレンダー名を表示する" Margin="0,0,0,6" />
      <CheckBox x:Name="ShowDescription" Content="通知に予定の説明を表示する" Margin="0,0,0,6" />
      <CheckBox x:Name="ShowActions" Content="通知に「開く」「スヌーズ」ボタンを表示する" Margin="0,0,0,16" />

      <CheckBox x:Name="StartWithWindows" Content="Windows へのサインイン時に自動起動する" Margin="0,0,0,8" />

      <CheckBox x:Name="CloseToTray" Content="閉じるボタンでタスクトレイに格納する" Margin="0,0,0,16" />

      <TextBlock Text="通知するカレンダー" FontSize="16" FontWeight="Bold" Foreground="#1F2333" Margin="0,0,0,4" />
      <TextBlock Text="すべて外すと「関係する全カレンダー」が対象になります。"
                 FontSize="12" Foreground="#7A8096" Margin="0,0,0,8" />
    </StackPanel>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="CalendarList" />
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2">
      <TextBlock x:Name="StatusText" FontSize="12" Foreground="#7A8096" Margin="0,0,0,10" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SyncButton" Content="今すぐ同期" Padding="14,6" Margin="0,0,8,0" Click="SyncButton_Click" />
        <Button x:Name="SignOutButton" Content="連携を解除" Padding="14,6" Margin="0,0,8,0" Click="SignOutButton_Click" />
        <Button x:Name="SaveButton" Content="保存" Padding="18,6" Click="SaveButton_Click"
                Background="#5865F2" Foreground="White" BorderThickness="0" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
