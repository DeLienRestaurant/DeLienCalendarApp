<Window x:Class="DeLienCalendar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DeLien Calendar"
        Height="860" Width="1320"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7FB">
  <Grid>
    <wv2:WebView2 x:Name="Web" Visibility="Hidden" />

    <Border x:Name="LoginPanel" Background="#F6F7FB">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
        <TextBlock Text="DeLien Calendar"
                   FontSize="30" FontWeight="Bold" Foreground="#1F2333"
                   HorizontalAlignment="Center" />
        <TextBlock Text="でりえんの予定をデスクトップから。"
                   FontSize="14" Foreground="#5B6072" Margin="0,8,0,28"
                   HorizontalAlignment="Center" />

        <TextBlock x:Name="LoginMessage"
                   Text="この端末を Discord アカウントに連携します。"
                   TextWrapping="Wrap" Foreground="#3A3F52" FontSize="14"
                   Margin="0,0,0,20" />

        <Button x:Name="LoginButton" Content="Discord でログイン"
                Click="LoginButton_Click"
                Height="46" FontSize="15" FontWeight="SemiBold"
                Foreground="White" Background="#5865F2" BorderThickness="0"
                Cursor="Hand" />

        <ProgressBar x:Name="LoginProgress" IsIndeterminate="True"
                     Height="4" Margin="0,16,0,0" Visibility="Collapsed"
                     Foreground="#5865F2" Background="#E3E5EF" BorderThickness="0" />

        <TextBlock x:Name="LoginHint"
                   Text="ブラウザが開きます。Discord でログインし「この端末を許可する」を押してください。"
                   TextWrapping="Wrap" Foreground="#8A8FA3" FontSize="12"
                   Margin="0,20,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
