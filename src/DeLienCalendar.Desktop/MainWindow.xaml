<Window x:Class="DeLienCalendar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DeLien Calendar"
        Height="860" Width="1320"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

  <Window.Resources>
    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TabActiveForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" Padding="10,6">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="CalendarTab" Content="カレンダー" GroupName="MainTabs"
                     Style="{StaticResource TabButton}" IsChecked="True"
                     Checked="CalendarTab_Checked" />
        <RadioButton x:Name="SettingsTab" Content="設定" GroupName="MainTabs"
                     Style="{StaticResource TabButton}" Margin="4,0,0,0"
                     Checked="SettingsTab_Checked" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <wv2:WebView2 x:Name="Web" Visibility="Hidden" />

      <Border x:Name="LoginPanel" Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
          <TextBlock Text="DeLien Calendar"
                     FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="でりえんの予定をデスクトップから。"
                     FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,28"
                     HorizontalAlignment="Center" />

          <TextBlock x:Name="LoginMessage"
                     Text="この端末を Discord アカウントに連携します。"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="14"
                     Margin="0,0,0,20" />

          <Button x:Name="LoginButton" Content="Discord でログイン"
                  Click="LoginButton_Click"
                  Height="46" FontSize="15" FontWeight="SemiBold"
                  Foreground="{DynamicResource AccentForegroundBrush}" Background="{DynamicResource AccentBrush}" BorderThickness="0"
                  Cursor="Hand" />

          <ProgressBar x:Name="LoginProgress" IsIndeterminate="True"
                       Height="4" Margin="0,16,0,0" Visibility="Collapsed"
                       Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HintBackgroundBrush}" BorderThickness="0" />

          <TextBlock x:Name="LoginHint"
                     Text="ブラウザが開きます。Discord でログインし「この端末を許可する」を押してください。"
                     TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                     Margin="0,20,0,0" />
        </StackPanel>
      </Border>

      <Grid x:Name="SettingsHost" Background="{DynamicResource AppBackgroundBrush}" Visibility="Collapsed" />
    </Grid>
  </Grid>
</Window>
