<UserControl x:Class="DeLienCalendar.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Resources>
    <Style x:Key="CategoryButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="12,9" Margin="0,1">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左: ジャンル -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="8,12">
          <RadioButton x:Name="CategoryGeneral" Content="一般" GroupName="SettingsCategory"
                       Style="{StaticResource CategoryButton}" IsChecked="True"
                       Checked="Category_Checked" Tag="general" />
          <RadioButton x:Name="CategoryAppearance" Content="外観" GroupName="SettingsCategory"
                       Style="{StaticResource CategoryButton}" Checked="Category_Checked" Tag="appearance" />
          <RadioButton x:Name="CategoryNotification" Content="通知" GroupName="SettingsCategory"
                       Style="{StaticResource CategoryButton}" Checked="Category_Checked" Tag="notification" />
          <RadioButton x:Name="CategorySound" Content="アラーム音" GroupName="SettingsCategory"
                       Style="{StaticResource CategoryButton}" Checked="Category_Checked" Tag="sound" />
          <RadioButton x:Name="CategoryCalendar" Content="カレンダー" GroupName="SettingsCategory"
                       Style="{StaticResource CategoryButton}" Checked="Category_Checked" Tag="calendar" />
          <RadioButton x:Name="CategoryVersion" Content="バージョン情報" GroupName="SettingsCategory"
                       Style="{StaticResource CategoryButton}" Checked="Category_Checked" Tag="version" />
        </StackPanel>
      </Border>

      <!-- 右: 選択中のジャンル -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
        <Grid MaxWidth="640" HorizontalAlignment="Left">

          <!-- 一般 -->
          <StackPanel x:Name="PanelGeneral">
            <TextBlock Text="起動と常駐" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="StartWithWindows" Content="PC へのサインイン時に自動起動する" Margin="0,0,0,8" />
            <CheckBox x:Name="CloseToTray" Content="閉じるボタンでタスクトレイに格納する" Margin="0,0,0,24" />

            <TextBlock Text="接続先" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="BaseUrlBox" Padding="6" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="変更はアプリの再起動後に反映されます。接続先を変えた場合は再ログインが必要です。" />
          </StackPanel>

          <!-- 外観 -->
          <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
            <TextBlock Text="表示テーマ" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="テーマ:" VerticalAlignment="Center" Width="120" />
              <ComboBox x:Name="ThemeCombo" Width="260" SelectionChanged="ThemeCombo_SelectionChanged" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="「Windows の設定に合わせる」を選ぶと OS のダークモード設定に追従します。アプリ内のカレンダー表示も同じテーマに切り替わります。" />
          </StackPanel>

          <!-- 通知 -->
          <StackPanel x:Name="PanelNotification" Visibility="Collapsed">
            <TextBlock Text="通知" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="NotificationsEnabled" Content="通知を有効にする" Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="通知スタイル:" VerticalAlignment="Center" Width="120" />
              <ComboBox x:Name="StyleCombo" Width="300" SelectionChanged="StyleCombo_SelectionChanged" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <TextBlock Text="リマインド時刻:" VerticalAlignment="Center" Width="120" />
              <ComboBox x:Name="ReminderMinutes" Width="200" />
            </StackPanel>

            <TextBlock Text="通知の内容" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="ShowCalendarName" Content="通知にカレンダー名を表示する" Margin="0,0,0,6" />
            <CheckBox x:Name="ShowDescription" Content="通知に予定の説明を表示する" Margin="0,0,0,6" />
            <CheckBox x:Name="ShowActions" Content="通知に「開く」「スヌーズ」ボタンを表示する" Margin="0,0,0,8" />
          </StackPanel>

          <!-- アラーム音 -->
          <StackPanel x:Name="PanelSound" Visibility="Collapsed">
            <TextBlock Text="アラーム音" Style="{StaticResource SectionTitle}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="音声:" VerticalAlignment="Center" Width="120" />
              <ComboBox x:Name="SoundCombo" Width="260" SelectionChanged="SoundCombo_SelectionChanged" />
              <Button x:Name="PreviewButton" Content="試聴" Padding="12,3" Margin="8,0,0,0" Click="PreviewButton_Click" />
            </StackPanel>

            <StackPanel x:Name="CustomSoundPanel" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
              <TextBlock Text="ファイル:" VerticalAlignment="Center" Width="120" />
              <TextBox x:Name="CustomSoundBox" Width="360" Padding="4" />
              <Button Content="参照…" Padding="12,3" Margin="8,0,0,0" Click="BrowseSound_Click" />
            </StackPanel>

            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,24"
                       Text="WAV / MP3 / M4A / AAC / WMA / FLAC に対応しています。通知スタイルが「サイレント」のときは鳴りません。" />

            <TextBlock Text="再生デバイス" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="出力先:" VerticalAlignment="Center" Width="120" />
              <ComboBox x:Name="DeviceCombo" Width="300" />
              <Button Content="再読込" Padding="12,3" Margin="8,0,0,0" Click="RefreshDevices_Click" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="トースト通知の音は Windows 側が鳴らすため、ここで選んだデバイスはアプリが再生するアラーム音に使われます。" />
          </StackPanel>

          <!-- カレンダー -->
          <StackPanel x:Name="PanelCalendar" Visibility="Collapsed">
            <TextBlock Text="通知するカレンダー" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                       Text="すべて外すと「関係する全カレンダー」が対象になります。" />
            <!-- 背景はテーマの surface 色にする（AccentForeground はダークで白のままで文字が読めなくなる） -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
              <StackPanel x:Name="CalendarList" />
            </Border>
          </StackPanel>

          <!-- バージョン情報 -->
          <StackPanel x:Name="PanelVersion" Visibility="Collapsed">
            <TextBlock Text="現在のバージョン" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="CurrentVersionText" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentHoverBrush}" />
            <TextBlock x:Name="UpdateStatusText" FontSize="13" Foreground="{DynamicResource TextBrush}"
                       Margin="0,8,0,14" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="CheckUpdateButton" Content="更新を確認" Padding="16,6" Margin="0,0,8,0"
                      Click="CheckUpdate_Click" />
              <Button x:Name="ApplyUpdateButton" Content="アップデートする" Padding="18,6" Margin="0,0,8,0"
                      Click="ApplyUpdate_Click" Visibility="Collapsed">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                        TextElement.Foreground="{DynamicResource AccentForegroundBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button x:Name="OpenReleaseButton" Content="リリースページを開く" Padding="16,6"
                      Click="OpenRelease_Click" Visibility="Collapsed" />
            </StackPanel>
            <CheckBox x:Name="AutoUpdateCheck" Content="起動時に更新を確認する（24時間に1回）" Margin="0,0,0,24" />

            <TextBlock Text="更新履歴" Style="{StaticResource SectionTitle}" />
            <StackPanel x:Name="ChangelogPanel" />
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>

    <!-- フッター（全ジャンル共通） -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <Grid>
        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,360,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="SyncButton" Content="今すぐ同期" Padding="14,6" Margin="0,0,8,0" Click="SyncButton_Click" />
          <Button x:Name="SignOutButton" Content="連携を解除" Padding="14,6" Margin="0,0,8,0" Click="SignOutButton_Click" />
          <Button x:Name="SaveButton" Content="保存" Padding="18,6" Click="SaveButton_Click"
                  Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderThickness="0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
