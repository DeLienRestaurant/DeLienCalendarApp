<UserControl x:Class="DeLienCalendar.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F7FB">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
    <StackPanel MaxWidth="680" HorizontalAlignment="Left">

      <TextBlock Text="通知" FontSize="16" FontWeight="Bold" Foreground="#1F2333" Margin="0,0,0,10" />

      <CheckBox x:Name="NotificationsEnabled" Content="通知を有効にする" Margin="0,0,0,10" />

      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock Text="通知スタイル:" VerticalAlignment="Center" Width="120" />
        <ComboBox x:Name="StyleCombo" Width="300" SelectionChanged="StyleCombo_SelectionChanged" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock Text="リマインド時刻:" VerticalAlignment="Center" Width="120" />
        <ComboBox x:Name="ReminderMinutes" Width="200" />
      </StackPanel>

      <CheckBox x:Name="ShowCalendarName" Content="通知にカレンダー名を表示する" Margin="0,0,0,6" />
      <CheckBox x:Name="ShowDescription" Content="通知に予定の説明を表示する" Margin="0,0,0,6" />
      <CheckBox x:Name="ShowActions" Content="通知に「開く」「スヌーズ」ボタンを表示する" Margin="0,0,0,16" />

      <TextBlock Text="起動と常駐" FontSize="16" FontWeight="Bold" Foreground="#1F2333" Margin="0,0,0,10" />
      <CheckBox x:Name="StartWithWindows" Content="PC へのサインイン時に自動起動する" Margin="0,0,0,6" />
      <CheckBox x:Name="CloseToTray" Content="閉じるボタンでタスクトレイに格納する" Margin="0,0,0,16" />

      <TextBlock Text="通知するカレンダー" FontSize="16" FontWeight="Bold" Foreground="#1F2333" Margin="0,0,0,4" />
      <TextBlock Text="すべて外すと「関係する全カレンダー」が対象になります。"
                 FontSize="12" Foreground="#7A8096" Margin="0,0,0,8" />
      <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,16">
        <StackPanel x:Name="CalendarList" />
      </Border>

      <TextBlock Text="接続先" FontSize="16" FontWeight="Bold" Foreground="#1F2333" Margin="0,0,0,8" />
      <TextBox x:Name="BaseUrlBox" Padding="6" />
      <TextBlock Text="変更はアプリの再起動後に反映されます。接続先を変えた場合は再ログインが必要です。"
                 FontSize="12" Foreground="#7A8096" Margin="0,6,0,20" TextWrapping="Wrap" />

      <TextBlock Text="アラーム音" FontSize="16" FontWeight="Bold" Foreground="#1F2333" Margin="0,0,0,8" />

      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="音声:" VerticalAlignment="Center" Width="120" />
        <ComboBox x:Name="SoundCombo" Width="260" SelectionChanged="SoundCombo_SelectionChanged" />
        <Button x:Name="PreviewButton" Content="試聴" Padding="12,3" Margin="8,0,0,0" Click="PreviewButton_Click" />
      </StackPanel>

      <StackPanel x:Name="CustomSoundPanel" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
        <TextBlock Text="ファイル:" VerticalAlignment="Center" Width="120" />
        <TextBox x:Name="CustomSoundBox" Width="360" Padding="4" />
        <Button Content="参照…" Padding="12,3" Margin="8,0,0,0" Click="BrowseSound_Click" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock Text="再生デバイス:" VerticalAlignment="Center" Width="120" />
        <ComboBox x:Name="DeviceCombo" Width="300" />
        <Button Content="再読込" Padding="12,3" Margin="8,0,0,0" Click="RefreshDevices_Click" />
      </StackPanel>
      <TextBlock Text="トースト通知は Windows の既定デバイスで鳴ります。ここで選んだデバイスはアプリが再生するアラーム音に使われます。"
                 FontSize="12" Foreground="#7A8096" Margin="0,0,0,20" TextWrapping="Wrap" />

      <TextBlock Text="更新" FontSize="16" FontWeight="Bold" Foreground="#1F2333" Margin="0,0,0,8" />
      <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="#3A3F52" Margin="0,0,0,8" TextWrapping="Wrap" />
      <CheckBox x:Name="AutoUpdateCheck" Content="起動時に更新を確認する（24時間に1回）" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <Button x:Name="CheckUpdateButton" Content="今すぐ確認" Padding="14,6" Margin="0,0,8,0" Click="CheckUpdate_Click" />
        <Button x:Name="OpenReleaseButton" Content="リリースページを開く" Padding="14,6" Click="OpenRelease_Click" />
      </StackPanel>

      <TextBlock x:Name="StatusText" FontSize="12" Foreground="#7A8096" Margin="0,0,0,10" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button x:Name="SyncButton" Content="今すぐ同期" Padding="14,6" Margin="0,0,8,0" Click="SyncButton_Click" />
        <Button x:Name="SignOutButton" Content="連携を解除" Padding="14,6" Margin="0,0,8,0" Click="SignOutButton_Click" />
        <Button x:Name="SaveButton" Content="保存" Padding="18,6" Click="SaveButton_Click"
                Background="#5865F2" Foreground="White" BorderThickness="0" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
